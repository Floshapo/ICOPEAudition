%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0049b67a3b555774f9c393f9988504b7, type: 3}
  m_Name: 0_0_Michel
  m_EditorClassIdentifier: 
  characterSprites:
  - {fileID: -1683400333343287881, guid: 910b9736db6936e43a44bd8a92397634, type: 3}
  - {fileID: 5001668446368383778, guid: 910b9736db6936e43a44bd8a92397634, type: 3}
  surname: Dupont
  fisrtName: Michel
  age: 68
  familySituation: "Mari\xE9 avec 3 enfants et retrait\xE9 de la SNCF."
  occupationalActivities: Il adore jardiner et raconter ses voyages en trains.
  context: "\xC0 la suite de la lecture d\u2019un article dans le journal, il a r\xE9alis\xE9
    un auto-d\xE9pistage ICOPE. La synth\xE8se de l\u2019\xE9valuation signale qu\u2019il
    y a peut-\xEAtre un d\xE9clin de l\u2019audition. Il a constat\xE9 aussi qu\u2019il
    avait une g\xEAne auditive r\xE9cente dans le bruit. L\u2019interpr\xE9tation
    de l\u2019alerte r\xE9alis\xE9e par un professionnel de sant\xE9 ICOPE, confirme
    cette suspicion de d\xE9clin et vous l\u2019adresse pour une \xE9valuation auditive.
    Vous le rencontrez pour la premi\xE8re fois.\r\n"
  autonomies:
  - name: ADL
    value: 6/6
  - name: IALD
    value: 8/8
  medicalHistory: "Dans ses ant\xE9c\xE9dents on retrouve une Hypertension art\xE9rielle
    trait\xE9e par Ramipril 5mg.\r"
  descriptionLevel: Ce tutoriel vous guide dans la prise en main du jeu et de l'algorithme.
  steps:
  - type: 0
    contextDescription: "\xC0 la suite de la lecture d\u2019un article dans le journal,
      il a r\xE9alis\xE9 un auto-d\xE9pistage ICOPE. La synth\xE8se de l\u2019\xE9valuation
      signale qu\u2019il y a peut-\xEAtre un d\xE9clin de l\u2019audition. Il a constat\xE9
      aussi qu\u2019il avait une g\xEAne auditive r\xE9cente dans le bruit. L\u2019interpr\xE9tation
      de l\u2019alerte r\xE9alis\xE9e par un professionnel de sant\xE9 ICOPE, confirme
      cette suspicion de d\xE9clin et vous l\u2019adresse pour une \xE9valuation
      auditive. Vous le rencontrez pour la premi\xE8re fois.\r"
    questionnaireData: {fileID: 0}
    predefinedAnwser: []
    spriteEarExams: {fileID: 0}
    hasDiagnosticPhase: 0
    diagnosticPhase:
      questionText: 
      answerData: []
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: "Je r\xE9alise une vid\xE9o-otoscopie."
        isCorrect: 0
        correctionText: "Il est important de bien respecter l\u2019algorithme d\xE9cisionnel.
          \r\nLe rep\xE9rage a \xE9t\xE9 fait en autod\xE9pistage. La premi\xE8re
          \xE9tape du Step 2 vise donc \xE0 confirmer la suspicion de surdit\xE9
          d\xE9tect\xE9e lors du rep\xE9rage. Pour cela, je peux utiliser :\r\n-
          Le test de chuchotement\r\n- Le test H\xF6ra\r\n- Le questionnaire HHIE-S\r\nSi
          la suspicion n\u2019est pas confirm\xE9e, il n\u2019est pas n\xE9cessaire
          de poursuivre l\u2019\xE9valuation.\r\n"
        sprites: []
      - answerText: "Je v\xE9rifie ses oreilles."
        isCorrect: 0
        correctionText: "Il est important de bien respecter l\u2019algorithme d\xE9cisionnel.
          \r\nLe rep\xE9rage a \xE9t\xE9 fait en autod\xE9pistage. La premi\xE8re
          \xE9tape du Step 2 vise donc \xE0 confirmer la suspicion de surdit\xE9
          d\xE9tect\xE9e lors du rep\xE9rage. Pour cela, je peux utiliser :\r\n-
          Le test de chuchotement\r\n- Le test H\xF6ra\r\n- Le questionnaire HHIE-S\r\nSi
          la suspicion n\u2019est pas confirm\xE9e, il n\u2019est pas n\xE9cessaire
          de poursuivre l\u2019\xE9valuation.\r\n"
        sprites: []
      - answerText: "Je ne peux rien faire, je renvoie le patient vers l\u2019ORL."
        isCorrect: 0
        correctionText: "Le patient est un bon candidat pour l\u2019\xE9valuation
          ICOPE : il a plus de 60 ans, son autonomie est pr\xE9serv\xE9e, le d\xE9pistage
          semble \xEAtre anormal.\r\nA ce stade, aucun drapeau rouge* identifi\xE9,
          je poursuis son \xE9valuation.\r\r"
        sprites: []
      - answerText: "Je r\xE9alise le test de chuchotement."
        isCorrect: 1
        correctionText: "Le patient ayant proc\xE9d\xE9 \xE0 un auto-d\xE9pistage
          ICOPE, le test de chuchotement n\u2019a pas \xE9t\xE9 r\xE9alis\xE9. Vous
          commencez par cette \xE9tape pour vous assurer qu\u2019il y a bien eu une
          anomalie \xE0 l\u2019\xE9tape 1. \r\r\r"
        sprites: []
    IsOptional: 0
    isTerminatingStep: 0
  - type: 1
    contextDescription: "Je n'ai entendu aucun mot \xE0 droite. J'ai entendu 2 mots
      \xE0 gauche.\r"
    questionnaireData: {fileID: 0}
    predefinedAnwser: []
    spriteEarExams: {fileID: 0}
    hasDiagnosticPhase: 1
    diagnosticPhase:
      questionText: Quel est votre diagnostic ?
      answerData:
      - answerText: "Il y a une anomalie car il n\u2019a pas su restituer les 2 mots
          du c\xF4t\xE9 droit."
        isCorrect: 0
        correctionText: "Le test est bien pathologique mais lors du test de chuchotement,
          l'\xE9valuation de l'audition consiste g\xE9n\xE9ralement \xE0 faire r\xE9p\xE9ter
          4 mots au patient pour chaque oreille et non 2 mots comme sur cette affirmation.
          \r\n\r\nDe plus, le patient \xE0 bien \xE9voqu\xE9 qu\u2019il n\u2019avait
          entendu aucun mot du c\xF4t\xE9 de l\u2019oreille droite. \r\n\r\nLe crit\xE8re
          normal pour consid\xE9rer qu'il n'y a pas d\u2019anomalie auditive est
          la r\xE9p\xE9tition correcte de l\u2019ensemble des 4 mots (ou 3 minimum
          par oreille)."
        sprites: []
      - answerText: "Il y a une anomalie car il n\u2019a pas su restituer les 3/4
          mots des 2 c\xF4t\xE9s."
        isCorrect: 1
        correctionText: "Lors du test de chuchotement, on consid\xE8re que l\u2019audition
          est normale si le patient est capable de r\xE9p\xE9ter correctement au
          moins 3 mots sur 4 pour chaque oreille.\r\nDans ce cas, le patient n\u2019a
          su r\xE9p\xE9ter que 2 mots sur 4 pour chaque c\xF4t\xE9, ce qui est en
          dessous du seuil requis.\r\nCela indique une atteinte de l\u2019audition
          bilat\xE9rale, car aucun des deux c\xF4t\xE9s n\u2019atteint le crit\xE8re
          minimal de 3 mots correctement restitu\xE9s sur 4.\r"
        sprites: []
      - answerText: "Je ne peux rien faire, je renvoie le patient vers l\u2019ORL."
        isCorrect: 0
        correctionText: "Non, il existe bien une anomalie. Lors du test de chuchotement,
          l'\xE9valuation de l'audition consiste g\xE9n\xE9ralement \xE0 faire r\xE9p\xE9ter
          4 mots au patient pour chaque oreille et non 2 mots comme sur cette affirmation.
          \r\n\r\nLe crit\xE8re normal pour consid\xE9rer qu'il n'y a pas d\u2019anomalie
          auditive est la r\xE9p\xE9tition correcte de l\u2019ensemble des 4 mots
          (ou 3 mots minimum par oreille).\r\nOr, dans ce cas pr\xE9cis, le patient
          n\u2019a r\xE9p\xE9t\xE9 que 2 mots sur 4 pour chaque oreille. Cela traduit
          une diminution de l'acuit\xE9 auditive bilat\xE9rale et constitue une anomalie
          du test."
        sprites: []
      - answerText: Le test est normal.
        isCorrect: 0
        correctionText: "Pour que le test soit consid\xE9r\xE9 comme normal, le patient
          doit \xEAtre capable de r\xE9p\xE9ter au moins 3 mots sur 4 par oreille.\r\nDans
          la situation d\xE9crite :\r\nLe patient a r\xE9p\xE9t\xE9 seulement 2 mots
          sur 4 du c\xF4t\xE9 gauche et 0 mots sur 4 du c\xF4t\xE9 droit,\r\nCela
          signifie qu\u2019il n\u2019atteint pas le seuil minimal requis pour une
          audition normale sur aucune des deux oreilles.\r\n\r\nLe test aurait \xE9t\xE9
          normal si le patient avait r\xE9p\xE9t\xE9 les 3 mots de chaque c\xF4t\xE9.\r"
        sprites: []
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: Je le laisse repartir chez lui.
        isCorrect: 0
        correctionText: "Le test de chuchotement est anormal, on peut donc commencer
          le questionnaire Go-No-Go afin de rep\xE9rer des signaux alertant sur une
          probable surdit\xE9 complexe, diff\xE9rente d'une simple prebyacousie dans
          sa pr\xE9sentation."
        sprites: []
      - answerText: "Je r\xE9alise le test de Weber."
        isCorrect: 0
        correctionText: "Avant de d\xE9marer l'\xE9valuation audition, on doit interroger
          le participant afin de rep\xE9rer les signaux alertant sur des \xE9ventuels
          dignostics diff\xE9rentiels (questionnaire Go-No-Go).\r\n"
        sprites: []
      - answerText: Je fais passer le questionnaire Go-No-Go.
        isCorrect: 1
        correctionText: "Le test de chuchotement \xE9tait anormal, nous poursuivons
          le d\xE9roul\xE9 de l\u2019\xE9tape 2 d\u2019ICOPE Audition, avec le questionnaire
          Go-No-Go.\r\r"
        sprites: []
      - answerText: "Je lui propose l\u2019application H\xD6RA pour se retester dans
          6 mois."
        isCorrect: 0
        correctionText: "Si le test de chuchotement avait \xE9t\xE9 normal, on aurait
          pu conclure a un faux positif du d\xE9pistage. On aurait alors rassur\xE9
          le participant, en lui rappelant les consignes de pr\xE9vention et de bonne
          hygi\xE8ne auriculaire. Un nouveau d\xE9pistage aurait alors \xE9t\xE9
          propos\xE9, par exemple avec H\xF6ra.\r\n\r\nIci : le test est anormal,
          il faut donc poursuivre l\u2019\xE9valuation auditive en commen\xE7ant
          par l\u2019interrogatoire (\xE0 l\u2019aide du questionnaire Go-No Go).\n"
        sprites: []
    IsOptional: 0
    isTerminatingStep: 0
  - type: 2
    contextDescription: "\r"
    questionnaireData: {fileID: 11400000, guid: a0759d5e048f0664aa15389120c01ca3, type: 2}
    predefinedAnwser:
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    - question:
        questionText: 
      patientAnswer: 1
    spriteEarExams: {fileID: 0}
    hasDiagnosticPhase: 1
    diagnosticPhase:
      questionText: Quel est votre diagnostic ?
      answerData:
      - answerText: "Ses r\xE9ponses montrent des signes d\u2019un trouble neurologique
          avanc\xE9. "
        isCorrect: 0
        correctionText: "Non, le questionnaire ne r\xE9v\xE8le simplement aucun signal
          d\u2019alerte quant \xE0 un cas complexe .\r\n\r\nIl ne s\u2019agit pas
          d\u2019un questionnaire de rep\xE9rage des troubles cognitifs, plut\xF4t
          d\u2019un outil d\u2019aide \xE0 l\u2019interrogatoire, afin de ne pas
          oublier les situations fortement \xE9vocatrices d\u2019une surdit\xE9 complexe
          qui justifieraient alors d\u2019un adressage ORL.\r\n"
        sprites: []
      - answerText: "Il n\u2019a r\xE9pondu que des \"non\", ce qui indique une suspicion
          de cas simple."
        isCorrect: 1
        correctionText: "Si aux r\xE9ponses du questionnaire Go-No-Go, le patient
          r\xE9ponds \"Non\" \xE0 chaque question, il s\u2019agit bien d\u2019une
          suspicion de cas simple.\r\n"
        sprites: []
      - answerText: "Ses r\xE9ponses ne montrent pas de probl\xE8me significatifs. "
        isCorrect: 0
        correctionText: "Non, ici il existe une suspicion de surdit\xE9 suite au
          test de chuchotement.\r\nCe questionnaire ne permet pas d\u2019\xE9valuer
          ou d\u2019estimer la fonction auditive du patient. Il s\u2019agit d\u2019un
          outil d\u2019aide \xE0 l\u2019interrogatoire, afin de ne pas oublier les
          situations fortement \xE9vocatrices d\u2019une surdit\xE9 complexe qui
          justifieraient alors d\u2019un adressage ORL.\r"
        sprites: []
      - answerText: "Il n\u2019a r\xE9pondu que des \"non\", ce qui indique une urgence
          ORL. "
        isCorrect: 0
        correctionText: "Les urgences ORL et autres situations n\xE9cessitant un
          avis ORL, sont plut\xF4t \xE9voqu\xE9es lorsque le candidat r\xE9pond \xAB\_OUI\_\xBB
          \xE0 une ou plusieurs questions.\r\n\r\nLes urgences vraies, justifiant
          de la mise en place d\u2019un traitement rapide sont :\r\n- Les surdit\xE9s
          brusques r\xE9centes, indiquant une corticoth\xE9rapie.\r\n- Les otorrh\xE9es
          avec otalgies, \xE9vocatrices d\u2019une otite externe.\r-"
        sprites: []
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: Je le laisse repartir chez lui.
        isCorrect: 0
        correctionText: "Non, son test de chuchotement est pathologique, il faut
          donc continuer l\u2019exploration. Le questionnaire a permis d\u2019\xE9liminer
          des signes \xE9vocateurs d\u2019une surdit\xE9 complexe, on continue avec
          l\u2019examen physique puis l\u2019\xE9valuation auditive.\r"
        sprites: []
      - answerText: "Je l\u2019adresse aux urgences."
        isCorrect: 0
        correctionText: "Aucune indication !\r\nSuspicion de surdit\xE9 sans signal
          d\u2019alarme \xE0 l\u2019interrogatoire, je peux donc r\xE9aliser mon
          examen physique.\n\n* Rappel des drapeaux rouges / questionnaire Go-No-Go.\r\n\r\n"
        sprites: []
      - answerText: "Je continue le parcours audition et lui fais passer une vid\xE9o
          otoscopie."
        isCorrect: 1
        correctionText: "Les \xE9tapes pr\xE9c\xE9dentes ne permettent pas de confirmer
          qu\u2019il n\u2019y a pas d\u2019anomalie auditive. La vid\xE9o otoscopie
          est l\u2019examen \xE0 r\xE9aliser en suivant. \r\n"
        sprites: []
      - answerText: "Je l\u2019envoie vers un ORL."
        isCorrect: 0
        correctionText: "Ici il n\u2019existe aucun drapeau rouge : il n\u2019y a
          donc pas d\u2019indication \xE0 un adressage ORL, je peux continuer mon
          \xE9valuation avec la r\xE9alisation de l\u2019examen physique (examen
          du pavillon et vid\xE9o-otoscopie).\n\r\n* Rappel des drapeaux rouges /
          questionnaire Go-No-Go."
        sprites: []
    IsOptional: 0
    isTerminatingStep: 0
  - type: 4
    contextDescription: "\r"
    questionnaireData: {fileID: 0}
    predefinedAnwser: []
    spriteEarExams: {fileID: 21300000, guid: 66ab745270a49f948bba06cb857acfbb, type: 3}
    hasDiagnosticPhase: 1
    diagnosticPhase:
      questionText: Quel est votre diagnostic ?
      answerData:
      - answerText: "Il s\u2019agit d\u2019une otite moyenne aigu\xEB."
        isCorrect: 0
        correctionText: "Une OMA est diagnostiqu\xE9e quand il existe une congestion
          de la membrane tympanique (phase congestive, photo de gauche), ou une congestion
          associ\xE9e \xE0 un \xE9panchement purulent r\xE9tro tympanique.\r\nOn
          constate souvent une disparition des rep\xE8res habituellement retrouv\xE9s
          \xE0 l\u2019otoscopie. Il existe une douleur associ\xE9e, souvent de la
          fi\xE8vre.\r\n"
        sprites:
        - {fileID: 21300000, guid: ab0791b59991394478c7e63451d833f5, type: 3}
        - {fileID: 21300000, guid: b5ca7212c3dd1014685c70d76ca23d6e, type: 3}
      - answerText: "Il s\u2019agit d\u2019une perforation tympanique."
        isCorrect: 0
        correctionText: "On peut suivre l\u2019annulus sur toute sa circonf\xE9rence,
          il n\u2019existe pas de perforation de la membrane.\r\n\r\n"
        sprites:
        - {fileID: 21300000, guid: c8721d873aaf0b442a563e92ea23f282, type: 3}
        - {fileID: 21300000, guid: 6751ff46d80eb624ca7a0619b16be793, type: 3}
      - answerText: "Il s\u2019agit d\u2019un bouchon de c\xE9rumen."
        isCorrect: 0
        correctionText: 
        sprites:
        - {fileID: 21300000, guid: f503c7a4e7193c945b6f71187b1b4708, type: 3}
        - {fileID: 21300000, guid: 074d65b9d59894e45a6ce7148c6c22f1, type: 3}
      - answerText: "Il s\u2019agit d\u2019un tympan normal."
        isCorrect: 1
        correctionText: "Un tympan normal est classiquement transparent, de couleur
          grise, bien tendu autour de la circonf\xE9rence (annulus), que fait le
          fond du Conduit Auditif Externe.\r"
        sprites:
        - {fileID: 21300000, guid: 66ab745270a49f948bba06cb857acfbb, type: 3}
        - {fileID: 21300000, guid: c61eaa268f3e45b4ebccd891cd90b737, type: 3}
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: Je le laisse repartir chez lui.
        isCorrect: 0
        correctionText: "On a un cas simple, avec un d\xE9pistage pathologique :
          il faut continuer son \xE9valuation ! la normalit\xE9 de l'examen otoscopique
          n'est en rien rassurante vis \xE0 vis du statut auditif du patient."
        sprites:
        - {fileID: 21300000, guid: 66ab745270a49f948bba06cb857acfbb, type: 3}
        - {fileID: 21300000, guid: c61eaa268f3e45b4ebccd891cd90b737, type: 3}
      - answerText: Je continue le parcours audition et lui fait passer le test de
          Weber.
        isCorrect: 1
        correctionText: "Les \xE9tapes pr\xE9c\xE9dentes ne permettent pas de confirmer
          qu\u2019il n\u2019y a pas d\u2019anomalie auditive. Le test de Weber est
          l\u2019examen \xE0 r\xE9aliser en suivant. \r\r"
        sprites: []
      - answerText: "Je l\u2019envoi aux urgences."
        isCorrect: 0
        correctionText: "L\u2019examen du tympan est normal, on peut poursuivre l\u2019exploration
          auditive par un Test acoum\xE9trique de Weber.\r\r"
        sprites: []
      - answerText: "Je prescris une proth\xE8se auditive."
        isCorrect: 0
        correctionText: "Non, on doit poursuivre l\u2019\xE9valuation auditive, pour
          confirmer qu\u2019on est bien face \xE0 un tableau de presbyacousie simple,
          ET avec une surdit\xE9 dans les crit\xE8res d\u2019appareillage audioproth\xE9tique.\r\nOn
          ne fait JAMAIS de prescription d\u2019appareillage sans avoir au pr\xE9alable
          r\xE9aliser un examen audiom\xE9trique complet.\r\r\r"
        sprites: []
    IsOptional: 0
    isTerminatingStep: 0
  - type: 5
    contextDescription: "Je n'arrive pas \xE0 savoir, j'ai entendu la m\xEAme chose
      des deux c\xF4t\xE9s."
    questionnaireData: {fileID: 0}
    predefinedAnwser: []
    spriteEarExams: {fileID: 0}
    hasDiagnosticPhase: 1
    diagnosticPhase:
      questionText: Quel est votre diagnostic ?
      answerData:
      - answerText: "Ses r\xE9ponses r\xE9v\xE8lent une surdit\xE9 de perception."
        isCorrect: 0
        correctionText: "Ici, c\u2019est un test de Weber qui est r\xE9alis\xE9 (pied
          du diapason au centre) : on recherche une asym\xE9trie de l\u2019audition
          qui se manifesterait par une lat\xE9ralisation du Weber (\xAB\_j\u2019entends
          \xE0 droite\_\xBB).\r\n\r\nLe test acoum\xE9trique de Rinne quant \xE0
          lui de d\xE9terminer si le syst\xE8me tympano-ossiculaire est fonctionnel
          (dans ce cas, il est Positif : on \xE9voque une audition normale ou une
          surdit\xE9 neurosensorielle) ou non (dans ce cas, il est n\xE9gatif : on
          \xE9voque une surdit\xE9 de perception).\r"
        sprites: []
      - answerText: "Ses r\xE9ponses ne r\xE9v\xE8lent pas d\u2019anomalie."
        isCorrect: 1
        correctionText: "Un son per\xE7u de la m\xEAme fa\xE7on aux 2 oreilles est
          un bon signe."
        sprites: []
      - answerText: "Ses r\xE9ponses r\xE9v\xE8lent une surdit\xE9 de transmission."
        isCorrect: 0
        correctionText: "C\u2019est plut\xF4t le test de Rinne qui permet d\u2019\xE9voquer
          une surdit\xE9 de transmission, quand il est n\xE9gatif.\r\n\r\nAutrement,
          quand le patient d\xE9crit une asym\xE9trie auditive, on peut \xE9voquer
          une surdit\xE9 de transmission quand il lat\xE9ralise le Weber du c\xF4t\xE9
          de l\u2019oreille la plus sourde.\r"
        sprites: []
      - answerText: "Ses r\xE9ponses r\xE9v\xE8lent un bouchon de c\xE9rumen."
        isCorrect: 0
        correctionText: "C\u2019est un diagnostic otoscopique !\r\n\r\nSi il avait
          un BDC c\xF4t\xE9 droit, avec une otoscopie normale \xE0 gauche, on pourrait
          s\u2019attendre \xE0 retrouver un Weber lat\xE9ralis\xE9 \xE0 droite si
          il est obstructif (et \xE0 condition qu\u2019il n\u2019existe pas d\u2019autre
          cause sous jacente d\u2019asym\xE9trie auditive). Mais le diagnostic du
          BDC resterait \u2026 clinique !\r\n\r"
        sprites:
        - {fileID: 21300000, guid: f503c7a4e7193c945b6f71187b1b4708, type: 3}
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: Je le laisse repartir chez lui.
        isCorrect: 0
        correctionText: "Non, le test de Weber est utile afin d\u2019orienter son
          examen audiom\xE9trique. On peut retrouver une surdit\xE9 s\xE9v\xE8re
          avec un test de Weber centr\xE9, \xE0 condition que l\u2019audition soit
          sym\xE9trique.\r\n\r\nIl n\u2019a aucun caract\xE8re rassurant concernant
          la normalit\xE9 de l\u2019audition.\r"
        sprites: []
      - answerText: Je continue le parcours audition et lui fait passer le test HHIE-S.
        isCorrect: 1
        correctionText: "Les \xE9tapes pr\xE9c\xE9dentes ne permettent pas de confirmer
          qu\u2019il n\u2019y a pas d\u2019anomalie auditive. Le test HHIE-S est
          l\u2019examen \xE0 r\xE9aliser en suivant.\r\r"
        sprites: []
      - answerText: Je le laisse repartir et lui propose de refaire ICOPE dans 6
          mois.
        isCorrect: 0
        correctionText: "Non, le test de Weber est utile afin d\u2019orienter son
          examen audiom\xE9trique. On peut retrouver une surdit\xE9 s\xE9v\xE8re
          avec un test de Weber centr\xE9, \xE0 condition que l\u2019audition soit
          sym\xE9trique.\r\n\r\nIl n\u2019a aucun caract\xE8re rassurant concernant
          la normalit\xE9 de l\u2019audition.\r\n"
        sprites: []
      - answerText: "J\u2019enl\xE8ve le bouchon de c\xE9rumen."
        isCorrect: 0
        correctionText: "Ici l\u2019examen otoscopique est normal, le Weber est en
          plus centr\xE9 : il n\u2019y aucun argument \xE9voquant la pr\xE9sence
          d\u2019un BDC !\r\n\r\nEn revanche, si \xE0 l\u2019examen on retrouve un
          BDC, il faut le retirer (si pas de contre indication) AVANT de r\xE9aliser
          l\u2019acoum\xE9trie au diapason, autrement les r\xE9ponses seront en lien
          avec la surdit\xE9 occasionn\xE9e par ce BDC\r\n\r\n"
        sprites:
        - {fileID: 21300000, guid: f503c7a4e7193c945b6f71187b1b4708, type: 3}
    IsOptional: 0
    isTerminatingStep: 0
  - type: 6
    contextDescription: 
    questionnaireData: {fileID: 0}
    predefinedAnwser: []
    spriteEarExams: {fileID: 21300000, guid: a50fa5d32fa79a642b558b1fdc55654f, type: 3}
    hasDiagnosticPhase: 1
    diagnosticPhase:
      questionText: Quel est votre diagnostic ?
      answerData:
      - answerText: "Le score est en faveur de difficult\xE9s mod\xE9r\xE9es."
        isCorrect: 1
        correctionText: "Le score > 8/40 permet de d\xE9pister une d\xE9ficience
          auditive (probabilit\xE9 11% pour un score entre 0 et 8) et le score >
          16/40 permettait de d\xE9tecter une surdit\xE9 avec une efficacit\xE9 maximale
          (88,4\_%) dans le travail de Duchene et al. 2022\r\r"
        sprites: []
      - answerText: "Le score indique une absence totale de g\xEAne auditive."
        isCorrect: 0
        correctionText: "Non, le score \xE0 14/40 est en faveur d\u2019une surdit\xE9
          mod\xE9r\xE9e.\r\nOn ne peut donc pas conclure \xE0 l\u2019absence de g\xE8ne
          auditive.\r\n\r\n\r"
        sprites: []
      - answerText: "Le test montre des difficult\xE9s auditives s\xE9v\xE8res."
        isCorrect: 0
        correctionText: "Non, en cas de difficult\xE9 auditive s\xE9v\xE8re on peut
          s\u2019attendre \xE0 retrouver un score > 24. Il s\u2019agit donc d\u2019une
          surdit\xE9 mod\xE9r\xE9e.\r\nLa probabilit\xE9 d\u2019\xEAtre porteur d\u2019une
          d\xE9ficience auditive augmentant avec le score.\r\r\n\r\n\r"
        sprites: []
      - answerText: "Le r\xE9sultat sugg\xE8re que les troubles auditifs sont uniquement
          li\xE9s \xE0 une fatigue passag\xE8re."
        isCorrect: 0
        correctionText: "Le score permet d\u2019obtenir la probabilit\xE9 d\u2019\xEAtre
          atteint d\u2019une d\xE9ficience auditive, \xE9ligible \xE0 un appareillage
          selon les crit\xE8res actuellement admis en France."
        sprites: []
    hasActionPhase: 1
    actionPhase:
      questionText: Ques faites-vous ?
      answerData:
      - answerText: "Je l\u2019oriente vers un ORL."
        isCorrect: 0
        correctionText: "Non, son questionnaire HHIES est alt\xE9r\xE9, ce qui sugg\xE8re
          la pr\xE9sence d'une surdit\xE9. Pour le confirmer, il faut r\xE9aliser
          l'examen audiom\xE9trique."
        sprites: []
      - answerText: "Je l'oriente vers son m\xE9decin traitant."
        isCorrect: 0
        correctionText: "Non, son questionnaire HHIES est alt\xE9r\xE9, ce qui sugg\xE8re
          la pr\xE9sence d\u2019une surdit\xE9. Pour le confirmer, il faut r\xE9aliser
          l\u2019examen audiom\xE9trique.\r\n"
        sprites: []
      - answerText: Je lui propose un prochain rendez-vous de suivi.
        isCorrect: 0
        correctionText: "Non, son questionnaire HHIES est alt\xE9r\xE9, ce qui sugg\xE8re
          la pr\xE9sence d\u2019une surdit\xE9. Pour le confirmer, il faut r\xE9aliser
          l\u2019examen audiom\xE9trique."
        sprites: []
      - answerText: "Il est pertinent de r\xE9aliser l\u2019audiom\xE9trie "
        isCorrect: 1
        correctionText: "L\u2019audiom\xE9trie va permettre de valider le diagnostic
          de presbyacousie en confirmant qu\u2019il s\u2019agit d\u2019une surdit\xE9
          neurosensorielle, bilat\xE9rale et sym\xE9trique, pr\xE9dominant souvent
          sur les fr\xE9quences aigu\xEBs.\r\nIl va \xE9galement renseigner sur la
          s\xE9v\xE9rit\xE9 de la surdit\xE9, et l\u2019indication ou non d\u2019un
          appareillage audioproth\xE9tique.\r\n"
        sprites: []
